<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Version>9.1.2</Version>
		<AssemblyName>QueryLogsSqliteApp</AssemblyName>
		<RootNamespace>QueryLogsSqlite</RootNamespace>
		<Description>Schreibt alle eingehenden DNS-Anfragen und ihre Antworten in eine SQLite-Datenbank, die sich unter Protokolle in der Weboberfläche durchsuchen lässt.\n\nHinweis: Der Durchsatz hängt vom Datenträger ab, auf dem die Datenbankdatei liegt. Für sehr hohe Last (über 20.000 Anfragen pro Sekunde) ist die App nicht geeignet.\n\nWarnung: Mit „Datenbank regelmäßig verdichten (VACUUM)“ führt die App nach dem Löschen alter Einträge VACUUM aus. Das erhöht die Last auf dem Datenträger und kann die App eine Weile blockieren. Am besten nur zeitweise einschalten, um die Datei zu verkleinern.</Description>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="DescriptionEn">
			<Value>Writes all incoming DNS queries and their responses to an SQLite database that can be searched under Logs in the web interface.\n\nNote: Throughput depends on the disk the database file is stored on. The app is not suitable for very high load (more than 20,000 queries per second).\n\nWarning: With "Compact the database regularly (VACUUM)" the app runs VACUUM after deleting old records. This increases disk load and can block the app for a while. Best enable it only temporarily to shrink the file.</Value>
		</AssemblyMetadata>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZenitiumDns.ApplicationCommon\ZenitiumDns.ApplicationCommon.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZenitiumLibrary.Net\ZenitiumLibrary.Net.csproj">
			<Private>false</Private>
		</ProjectReference>
		<ProjectReference Include="..\..\src\ZenitiumLibrary\ZenitiumLibrary.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<None Update="dnsApp.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
