<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>11.2.1</Version>
		<AssemblyName>AdvancedBlockingApp</AssemblyName>
		<RootNamespace>AdvancedBlocking</RootNamespace>
		<Description>Blockiert Domains anhand von Blocklisten, Listen mit regulären Ausdrücken und Adblock-Listen. Für Client-IP-Adressen, Subnetze oder lokale Endpunkte lassen sich Gruppen mit jeweils eigenen Listen anlegen.\n\nHinweis: Die App arbeitet unabhängig von der eingebauten Blockierung des Servers. Die Blockier-Einstellungen unter Einstellungen gelten nicht für diese App.</Description>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="DescriptionEn">
			<Value>Blocks domains based on block lists, regular expression lists and Adblock lists. Groups with their own lists can be created for client IP addresses, subnets or local endpoints.\n\nNote: The app works independently of the server's built-in blocking. The blocking settings under Settings do not apply to this app.</Value>
		</AssemblyMetadata>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZenitiumDns.ApplicationCommon\ZenitiumDns.ApplicationCommon.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZenitiumLibrary\ZenitiumLibrary.csproj">
			<Private>false</Private>
		</ProjectReference>
		<ProjectReference Include="..\..\src\ZenitiumLibrary.IO\ZenitiumLibrary.IO.csproj" />
		<ProjectReference Include="..\..\src\ZenitiumLibrary.Net\ZenitiumLibrary.Net.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<None Update="dnsApp.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
