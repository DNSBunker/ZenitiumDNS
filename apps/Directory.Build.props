<Project>

	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

	<PropertyGroup>
		<DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
	</PropertyGroup>

	<ItemDefinitionGroup>
		<ProjectReference>
			<ExcludeAssets>all</ExcludeAssets>
		</ProjectReference>
	</ItemDefinitionGroup>

</Project>
