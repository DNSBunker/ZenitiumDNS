<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>8.1</Version>
		<AssemblyName>DropRequestsApp</AssemblyName>
		<RootNamespace>DropRequests</RootNamespace>
		<Description>Verwirft eingehende DNS-Anfragen von gesperrten Netzen oder mit gesperrten Namen und Typen, ohne zu antworten.</Description>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="DescriptionEn">
			<Value>Drops incoming DNS queries from blocked networks or with blocked names and types without answering.</Value>
		</AssemblyMetadata>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZenitiumDns.ApplicationCommon\ZenitiumDns.ApplicationCommon.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZenitiumLibrary\ZenitiumLibrary.csproj">
			<Private>false</Private>
		</ProjectReference>
		<ProjectReference Include="..\..\src\ZenitiumLibrary.Net\ZenitiumLibrary.Net.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<None Update="dnsApp.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="README.md;README.de.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
