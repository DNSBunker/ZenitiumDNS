<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Version>3.2</Version>
		<AssemblyName>QueryLogsSqlServerApp</AssemblyName>
		<RootNamespace>QueryLogsSqlServer</RootNamespace>
		<Description>Schreibt alle eingehenden DNS-Anfragen und ihre Antworten in eine Microsoft-SQL-Server-Datenbank, die sich unter Protokolle in der Weboberfläche durchsuchen lässt.\n\nHinweis: Lege einen Datenbankbenutzer an und gib ihm die Serverrolle „dbcreator“, damit die App die Datenbank anlegen und einrichten kann. Trage danach in der Konfiguration der App Datenbankname und Verbindungszeichenfolge ein und schalte die Protokollierung ein. Beim Speichern legt die App das Datenbankschema selbst an und beginnt mit der Protokollierung.</Description>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="DescriptionEn">
			<Value>Writes all incoming DNS queries and their responses to a Microsoft SQL Server database that can be searched under Logs in the web interface.\n\nNote: Create a database user and give it the server role "dbcreator" so that the app can create and set up the database. Then enter the database name and connection string in the app configuration and enable logging. When saving, the app creates the database schema itself and starts logging.</Value>
		</AssemblyMetadata>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZenitiumDns.ApplicationCommon\ZenitiumDns.ApplicationCommon.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZenitiumLibrary.Net\ZenitiumLibrary.Net.csproj">
			<Private>false</Private>
		</ProjectReference>
		<ProjectReference Include="..\..\src\ZenitiumLibrary\ZenitiumLibrary.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<None Update="dnsApp.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="README.md;README.de.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
