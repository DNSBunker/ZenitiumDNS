<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>5.2</Version>
		<AssemblyName>AdvancedForwardingApp</AssemblyName>
		<RootNamespace>AdvancedForwarding</RootNamespace>
		<Description>Leitet Anfragen für viele Domains gebündelt an eigene Forwarder weiter (bedingte Weiterleitung). Für Client-IP-Adressen oder Subnetze lassen sich Gruppen mit jeweils eigener Weiterleitung anlegen. Upstream-Dateien im AdGuard-Format werden unterstützt.\n\nHinweis: Die App arbeitet unabhängig von den eingebauten Weiterleitungszonen des Servers.</Description>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="DescriptionEn">
			<Value>Forwards queries for many domains in bulk to custom forwarders (conditional forwarding). Groups with their own forwarding can be created for client IP addresses or subnets. Upstream files in AdGuard format are supported.\n\nNote: The app works independently of the server's built-in forwarder zones.</Value>
		</AssemblyMetadata>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZenitiumDns.ApplicationCommon\ZenitiumDns.ApplicationCommon.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZenitiumLibrary\ZenitiumLibrary.csproj">
			<Private>false</Private>
		</ProjectReference>
		<ProjectReference Include="..\..\src\ZenitiumLibrary.Net\ZenitiumLibrary.Net.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<None Update="adguard-upstreams.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="dnsApp.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
