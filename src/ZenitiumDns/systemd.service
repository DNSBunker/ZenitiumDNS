[Unit]
Description=ZenitiumDNS
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=zenitiumdns
Group=zenitiumdns
SyslogIdentifier=zenitiumdns

WorkingDirectory=/opt/zenitiumdns
ReadWritePaths=/etc/zenitiumdns /var/log/zenitiumdns

Environment="OPENSSL_ENABLE_SHA1_SIGNATURES=1"

ExecStart=/usr/bin/dotnet /opt/zenitiumdns/ZenitiumDns.dll /etc/zenitiumdns

Restart=always
RestartSec=10

LockPersonality=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RemoveIPC=true
RestrictRealtime=true
RestrictSUIDSGID=true

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

UMask=0077

[Install]
WantedBy=multi-user.target
